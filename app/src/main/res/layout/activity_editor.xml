<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkcat_black"
    android:orientation="vertical">
    <ImageView android:id="@+id/editor_image" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="Photo editor" android:scaleType="fitCenter" />
    <TextView android:id="@+id/editor_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="Rotate now; drawing and annotations are next." android:textColor="@color/darkcat_muted" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="8dp">
        <Button android:id="@+id/rotate_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rotate" />
        <Button android:id="@+id/cancel_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cancel" />
        <Button android:id="@+id/save_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save to vault" />
    </LinearLayout>
</LinearLayout>
